{
  "name": "dot-test-digest",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded test, compiler and build output compressor (SPEC-002-DOT-TEST-DIGEST).",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.9.0",
  "bin": { "dot-test-digest": "dist/index.js" },
  "files": ["dist", "schema"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance": "node scripts/acceptance/run-acceptance.mjs",
    "schema": "node scripts/schema.mjs",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.32.2", "zod": "^3.25" },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
